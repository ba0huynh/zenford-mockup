  "libraries": [],
  "components": [
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Nút sticker: viền ink 2.5px, bóng đặc lệch 4px, nhấn thì nút lún xuống và bóng biến mất."
    },
    {
      "name": "Card",
      "group": "Surfaces",
      "summary": "Thẻ sticker: nền trắng hoặc pastel, viền ink, bóng đặc 5px, có thể nghiêng nhẹ."
    },
    {
      "name": "Overline",
      "group": "Text",
      "summary": "Nhãn nhỏ viết HOA phía trên tiêu đề mục, có viên vàng viền ink ở đầu."
    },
    {
      "name": "Tag",
      "group": "Text",
      "summary": "Nhãn trạng thái nhỏ hình viên thuốc, viền ink 2px."
    },
    {
      "name": "Pill",
      "group": "Inputs",
      "summary": "Viên chọn: bấm để lọc hoặc chọn một giá trị; đang chọn thì nền ink chữ trắng."
    },
    {
      "name": "Switch",
      "group": "Inputs",
      "summary": "Công tắc bật tắt cho quyền riêng tư, điểm danh, tự gia hạn."
    },
    {
      "name": "ProgressBar",
      "group": "Feedback",
      "summary": "Thanh tiến độ viền ink, chạy từ 0 tới giá trị khi xuất hiện."
    },
    {
      "name": "AnswerOption",
      "group": "Inputs",
      "summary": "Ô đáp án trong bài kiểm tra và Lab: đúng thì nền mint viền xanh, sai thì viền đỏ nét đứt, luôn kèm chữ."
    },
    {
      "name": "LangTile",
      "group": "Surfaces",
      "summary": "Ô chữ ngôn ngữ: một ký tự đại diện lớn trên nền pastel riêng của từng ngôn ngữ."
    },
    {
      "name": "ZenSay",
      "group": "Mascot",
      "summary": "Zen nói một câu: linh vật kèm bong bóng thoại nền bơ."
    }
  ],
